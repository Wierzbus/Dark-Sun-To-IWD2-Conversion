// Nowe lokacje IWD2 z obrazow wlasnych (wydzielone z BGtoIWD2_mod, gdzie byly komponentami 6 i 7).
// Najpierw: python -m geometry.image_area --dir areas_custom/ARxxxx --name ARxxxx (tools\cykl.cmd robi to sam).
// Folder mod/iwd2_nowe_lokacje i setup-iwd2_nowe_lokacje.exe musza lezec w katalogu IWD2.
// Obszary nie maja wyjsc ani wejsc z innych lokacji - do testu skok konsola.
BACKUP ~iwd2_nowe_lokacje/backup~
AUTHOR ~Wierzbus~

BEGIN ~Nowa lokacja AR9020 (pustynny kanion z obrazu wlasnego): TIS, WED ze scianami, ARE, minimapa i mapy SR/HT/LM~ DESIGNATED 1
  REQUIRE_PREDICATE (GAME_IS ~iwd2~) ~Ten komponent dziala tylko w Icewind Dale 2.~
  INCLUDE ~iwd2_nowe_lokacje/build/AR9020/install.tph~

BEGIN ~Nowa lokacja AR9021 (labirynt w rzucie ukosnym, plan z obrazu obrocony o 45 stopni): TIS, WED ze scianami, ARE, minimapa i mapy SR/HT/LM~ DESIGNATED 2
  REQUIRE_PREDICATE (GAME_IS ~iwd2~) ~Ten komponent dziala tylko w Icewind Dale 2.~
  INCLUDE ~iwd2_nowe_lokacje/build/AR9021/install.tph~

BEGIN ~TEST: AR9022 - pierwszy obszar Dark Sun (cele niewolnikow pod arena Draj, RGN29) w rzucie 45 stopni, z postaciami, dialogami i skryptami~ DESIGNATED 3
  REQUIRE_PREDICATE (GAME_IS ~iwd2~) ~Ten komponent dziala tylko w Icewind Dale 2.~
  // Najpierw: python tools/ds_obszar.py --game KATALOG_DARK_SUN --ds build/darksun (buduje build/AR9022 z danymi gry).
  INCLUDE ~iwd2_nowe_lokacje/build/AR9022/install.tph~

BEGIN ~TEST: skok do nowych lokacji (AR9020, AR9021, AR9022 - te zainstalowane) w dialogu Hedrona Kerdosa na dokach Targos~ DESIGNATED 4
  REQUIRE_PREDICATE (GAME_IS ~iwd2~) ~Ten komponent dziala tylko w Icewind Dale 2.~
  // 1. Dialogi Hedrona: CRE o imieniu "Hedron Kerdos" (pole 0x626 = dialog). Nic nie jest zapisywane.
  ACTION_CLEAR_ARRAY ds_hedron
  COPY_EXISTING_REGEXP GLOB ~^.+\.cre$~ ~override~
    PATCH_IF (BUFFER_LENGTH > 0x62E) BEGIN
      READ_ASCII 0x00 sig (8)
      PATCH_IF (~%sig%~ STRING_EQUAL ~CRE V2.2~) BEGIN
        READ_STRREF 0x08 imie
        PATCH_IF (~%imie%~ STRING_EQUAL_CASE ~Hedron Kerdos~) BEGIN
          READ_ASCII 0x626 dlg (8) NULL
          PATCH_IF (~%dlg%~ STRING_COMPARE_CASE ~None~ AND ~%dlg%~ STRING_COMPARE_CASE ~~) BEGIN
            TO_UPPER dlg
            SET $ds_hedron(~%dlg%~) = 1
          END
        END
      END
    END
  BUT_ONLY_IF_IT_CHANGES
  OUTER_SET ile = 0
  ACTION_PHP_EACH ds_hedron AS dlg => v BEGIN
    // 2. Stany, w ktorych gracz wybiera odpowiedz (wszystkie przejscia maja tekst) - tam dopisujemy skok.
    OUTER_TEXT_SPRINT stany ~~
    COPY_EXISTING ~%dlg%.dlg~ ~override~
      READ_LONG 0x08 n_st
      READ_LONG 0x0C o_st
      READ_LONG 0x14 o_tr
      FOR (i = 0; i < n_st; ++i) BEGIN
        READ_LONG (o_st + 16 * i + 4) t0
        READ_LONG (o_st + 16 * i + 8) tn
        SET wszystkie = (tn > 0)
        FOR (j = 0; j < tn; ++j) BEGIN
          READ_LONG (o_tr + 32 * (t0 + j)) fl
          PATCH_IF ((fl BAND 1) = 0) BEGIN SET wszystkie = 0 END
        END
        PATCH_IF wszystkie BEGIN TEXT_SPRINT stany ~%stany% %i%~ END
      END
    BUT_ONLY_IF_IT_CHANGES
    ACTION_IF (~%stany%~ STRING_COMPARE ~~) BEGIN
      ACTION_FOR_EACH obszar IN ~AR9020~ ~AR9021~ ~AR9022~ BEGIN
        ACTION_IF FILE_EXISTS_IN_GAME ~%obszar%.are~ BEGIN
          COPY_EXISTING ~%obszar%.are~ ~override~
            READ_LONG 0x78 o_ent
            READ_SHORT (o_ent + 0x20) x
            READ_SHORT (o_ent + 0x22) y
          BUT_ONLY_IF_IT_CHANGES
          COMPILE EVALUATE_BUFFER ~iwd2_nowe_lokacje/skok/skok.d~
          OUTER_SET ile = ile + 1
          PRINT ~%dlg%: skok do %obszar% [%x%.%y%] w stanach%stany%~
        END
      END
    END
  END
  ACTION_IF (ile = 0) BEGIN
    FAIL ~Nie znaleziono dialogu Hedrona Kerdosa albo zadnej z lokacji AR9020-AR9022 (zainstaluj najpierw komponent 1, 2 lub 3).~
  END
