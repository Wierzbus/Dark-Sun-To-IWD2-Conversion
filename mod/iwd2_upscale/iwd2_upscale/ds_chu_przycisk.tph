// Dodaje kontrolke do okna CHU: kopia kontrolki %wzor% z nowym id %nowe_id%, przesunieta w dol o odstep
// miedzy kontrolkami %wzor_pop% i %wzor% (uklad 800x600 i 1920x1080). Nic nie robi, gdy kontrolka juz jest.
// Uzycie (przycisk 14 bostwa kaplana w oknie 12 GUICG.CHU, potrzebny podklasom Dark Sun):
//   COPY_EXISTING ~GUICG.CHU~ ~override~ LPF ds_chu_przycisk INT_VAR okno = 12 wzor = 9 wzor_pop = 8 nowe_id = 14 END
DEFINE_PATCH_FUNCTION ds_chu_przycisk
  INT_VAR okno = 12 wzor = 9 wzor_pop = 8 nowe_id = 14
  RET dodano
BEGIN
  SET dodano = 0
  READ_LONG 0x08 nw
  READ_LONG 0x0c co
  READ_LONG 0x10 wo
  SET w_idx = 0 - 1
  FOR (w = 0; w < nw; ++w) BEGIN
    READ_SHORT (wo + w * 28) wid
    PATCH_IF (wid = okno) BEGIN SET w_idx = w END
  END
  PATCH_IF (w_idx >= 0) BEGIN
    READ_SHORT (wo + w_idx * 28 + 14) nc
    READ_SHORT (wo + w_idx * 28 + 24) fc
    SET jest = 0
    SET k_wz = 0 - 1
    SET y_pop = 0 - 1
    FOR (c = fc; c < fc + nc; ++c) BEGIN
      READ_LONG (co + c * 8) off
      READ_SHORT off cid
      PATCH_IF (cid = nowe_id) BEGIN SET jest = 1 END
      PATCH_IF (cid = wzor) BEGIN SET k_wz = c END
      PATCH_IF (cid = wzor_pop) BEGIN READ_SHORT (off + 6) y_pop END
    END
    PATCH_IF ((jest = 0) AND (k_wz >= 0) AND (y_pop >= 0)) BEGIN
      // 1. nowy wpis w tabeli kontrolek na koncu kontrolek okna
      SET ins = co + (fc + nc) * 8
      SET n_all = 0
      FOR (w = 0; w < nw; ++w) BEGIN
        READ_SHORT (wo + w * 28 + 14) wn
        READ_SHORT (wo + w * 28 + 24) wf
        PATCH_IF ((wf + wn) > n_all) BEGIN SET n_all = wf + wn END
      END
      INSERT_BYTES ins 8
      PATCH_IF (wo >= ins) BEGIN
        SET wo = wo + 8
        WRITE_LONG 0x10 wo
      END
      // 2. przesuniecie danych kontrolek (leza za tabela) i indeksow pierwszej kontrolki dalszych okien
      FOR (c = 0; c <= n_all; ++c) BEGIN
        PATCH_IF ((co + c * 8) != ins) BEGIN
          READ_LONG (co + c * 8) off
          PATCH_IF (off >= ins) BEGIN WRITE_LONG (co + c * 8) (off + 8) END
        END
      END
      FOR (w = 0; w < nw; ++w) BEGIN
        READ_SHORT (wo + w * 28 + 24) wf
        PATCH_IF ((w != w_idx) AND (wf >= (fc + nc))) BEGIN WRITE_SHORT (wo + w * 28 + 24) (wf + 1) END
      END
      WRITE_SHORT (wo + w_idx * 28 + 14) (nc + 1)
      // 3. dane nowej kontrolki: kopia wzoru na koncu pliku
      READ_LONG (co + k_wz * 8) off_wz
      READ_LONG (co + k_wz * 8 + 4) len_wz
      SET nowy = BUFFER_LENGTH
      INSERT_BYTES nowy len_wz
      FOR (i = 0; i < len_wz; ++i) BEGIN
        READ_BYTE (off_wz + i) b
        WRITE_BYTE (nowy + i) b
      END
      WRITE_LONG ins nowy
      WRITE_LONG (ins + 4) len_wz
      READ_SHORT (off_wz + 6) y_wz
      WRITE_SHORT nowy nowe_id
      WRITE_SHORT (nowy + 6) (y_wz + y_wz - y_pop)
      SET dodano = 1
    END
  END
END
